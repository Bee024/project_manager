MONGO_URI=mongodb://127.0.0.1:27017/project-camp
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://manager-alpha-taupe.vercel.app
FRONTEND_URL=https://manager-alpha-taupe.vercel.app

ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
ACCESS_TOKEN_EXPIRY=15m

REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-secret
REFRESH_TOKEN_EXPIRY=7d

MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=

# Leave API_BASE_URL empty for same-origin deployments.
# Set it to your backend URL only when the frontend is deployed separately.
API_BASE_URL=
SERVER_URL=http://localhost:3000
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:3000/reset-password
