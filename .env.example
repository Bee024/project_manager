MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
PORT=3000
NODE_ENV=development

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

ACCESS_TOKEN_SECRET=replace_with_long_random_secret
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=replace_with_different_long_random_secret
REFRESH_TOKEN_EXPIRY=7d

# ── Email ────────────────────────────────────────────────────────────────────
# Option 1 — Resend (recommended, free 3 000 emails/month): https://resend.com
RESEND_API_KEY=

# Option 2 — Generic SMTP (SendGrid, Postmark, Brevo, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# "From" address shown to recipients (use a verified domain address in production)
EMAIL_FROM=Project Camp <noreply@yourdomain.com>

# Option 3 — Mailtrap sandbox (local dev only, emails never reach real inboxes)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
# ─────────────────────────────────────────────────────────────────────────────

SERVER_URL=http://localhost:3000
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:3000/reset-password
