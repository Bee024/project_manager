MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>
PORT=3000
NODE_ENV=development

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

ACCESS_TOKEN_SECRET=replace_with_long_random_secret
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=replace_with_different_long_random_secret
REFRESH_TOKEN_EXPIRY=7d

# ── Email ────────────────────────────────────────────────────────────────────
# The code picks the first provider whose env vars are set, in this order:
#   1. Resend SMTP  — set RESEND_API_KEY  (requires a verified custom domain for multi-recipient)
#   2. Generic SMTP — set SMTP_HOST       (Gmail, SendGrid, Postmark, Brevo, etc.)
#   3. Mailtrap     — fallback for local dev only (never reaches real inboxes)

# Option 1 — Resend (re-enable when you have a verified domain)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Project Camp <noreply@yourdomain.com>

# Option 2 — Gmail SMTP (works immediately, no domain needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=Project Camp <your_gmail@gmail.com>

# Option 3 — Mailtrap sandbox (local dev only)
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=
MAILTRAP_SMTP_PASS=
# ─────────────────────────────────────────────────────────────────────────────

SERVER_URL=http://localhost:3000
FORGOT_PASSWORD_REDIRECT_URL=http://localhost:3000/reset-password
